<UserControl x:Class="zadanko.UserControl2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:zadanko"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid Background="#FF9260A5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button x:Name="BackButton2" Grid.Row="0" Content="Powrót" HorizontalAlignment="Left" VerticalAlignment="Top" Width="90" Height="32" Margin="8" Click="BackButton2_Click"/>
        <TextBlock Text="Akcja" Grid.Row="0" HorizontalAlignment="Center" FontSize="50" Foreground="#FFDBB2EC" FontFamily="Sitka Small" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <TextBox x:Name="SearchTextBox"
                     Width="300" Height="36"
                     Margin="0,0,0,0"
                     VerticalContentAlignment="Center"
                     Background="#FFF3E8FF"
                     Foreground="#FF3C1565"
                     TextChanged="SearchTextBox_TextChanged" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button x:Name="EditButton2" Width="120" Height="40" FontSize="20" Content="Edytuj" BorderBrush="#FF6D6464" Background="#FFD4A2E8" Margin="8,0" Click="EditButton_Click"/>
            <Button x:Name="AddButton2" Width="120" Height="40" FontSize="20" Content="Dodaj" Background="#FFD4A2E8" Margin="8,0" Click="AddButton_Click"/>
            <Button x:Name="RemoveButton2" Width="120" Height="40" FontSize="20" Content="Usuń" Background="#FFD4A2E8" Margin="8,0" Click="RemoveButton_Click"/>
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <ListBox x:Name="BooksList" ItemsSource="{Binding}" Background="Transparent" BorderThickness="0" Padding="12">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FFE9D7FF" CornerRadius="8" Margin="0,0,0,8" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" Foreground="#FF3C1565"/>
                                <TextBlock Text="{Binding Author}" FontSize="16" Foreground="#FF5C3C75"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </Grid>
</UserControl>
